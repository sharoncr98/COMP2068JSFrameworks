
<script id="chartData" type="application/json">{{{chartData}}}</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/javascripts/charts.js"></script>

<div class="container-fluid">
  <h1 class="mb-4">Dashboard</h1>
  <div class="row mb-4">
    <!-- Weather widget layout -->
    {{#if weather}}
    <div class="col-md-4 mb-3">
      <div class="weather-widget">
        <h4>{{weather.city}} Weather</h4>
        <img src="https://openweathermap.org/img/wn/{{weather.icon}}@2x.png" alt="Weather icon">
        <div class="weather-temp">{{weather.temp}}°C</div>
        <p class="text-capitalize">{{weather.description}}</p>
        <small>Feels like {{weather.feelsLike}}°C</small>
      </div>
    </div>
    {{/if}}
    <!-- Stats Cards -->
    <div class="col-md-8">
      <div class="row">
        <div class="col-md-4 mb-3">
          <div class="stat-card">
            <h3>{{stats.totalWorkouts}}</h3>
            <p>Total Workouts</p>
            <small>{{stats.thisWeekWorkouts}} this week</small>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="stat-card">
            <h3>{{stats.totalMeals}}</h3>
            <p>Meals Logged</p>
            <small>{{stats.thisWeekMeals}} this week</small>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="stat-card">
            <h3>{{stats.totalMoods}}</h3>
            <p>Mood Entries</p>
            <small>{{stats.thisWeekMoods}} this week</small>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <div class="stat-card">
            <h3>{{stats.totalCaloriesBurned}}</h3>
            <p>Calories Burned</p>
          </div>
        </div>
        <div class="col-md-6 mb-3">
          <div class="stat-card">
            <h3>{{stats.totalCaloriesConsumed}}</h3>
            <p>Calories Consumed</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Charts Section -->
  <div class="row mb-4">
    <div class="col-md-6 mb-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Workout Duration (Last 7 Days)</h5>
        </div>
        <div class="card-body">
          <div class="chart-container">
            <canvas id="workoutChart"></canvas>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6 mb-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Daily Calories (Last 7 Days)</h5>
        </div>
        <div class="card-body">
          <div class="chart-container">
            <canvas id="caloriesChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row mb-4">
    <div class="col-md-6 mb-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Mood Distribution (Last 30 Days)</h5>
        </div>
        <div class="card-body">
          <div class="chart-container">
            <canvas id="moodChart"></canvas>
          </div>
        </div>
      </div>
    </div>
    <!-- Recent Activity section-->
    <div class="col-md-6 mb-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Recent Activity</h5>
        </div>
        <div class="card-body">
          <h6>Recent Workouts</h6>
          {{#if recentWorkouts.length}}
            {{#each recentWorkouts}}
              <div class="recent-item">
                <strong>{{this.type}}</strong> - {{this.duration}} min
                <br><small>{{this.date}}</small>
              </div>
            {{/each}}
          {{else}}
            <p class="text-muted">No recent workouts</p>
          {{/if}}
          <h6 class="mt-3">Recent Moods</h6>
          {{#if recentMoods.length}}
            {{#each recentMoods}}
              <div class="recent-item">
                <strong>{{this.mood}}</strong> ({{this.intensity}}/10)
                <br><small>{{this.date}}</small>
              </div>
            {{/each}}
          {{else}}
            <p class="text-muted">No recent mood entries</p>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>