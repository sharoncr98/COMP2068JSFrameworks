<div class="jumbotron">
  <h1 class="display-4">Welcome to Wellness Tracker</h1>
  <p class="lead">Track your Daily Activity</p>
  <hr class="my-4">
  {{#if currentUser}}
    <p>Welcome back, {{currentUser.username}}! Ready to track your wellness journey?</p>
    <div class="row mt-4">
      <div class="col-md-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Workouts</h5>
            <p class="card-text">Track your exercise routines and progress</p>
            <a href="/workouts" class="btn btn-primary">View Workouts</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Meals</h5>
            <p class="card-text">Your daily meals and nutrition</p>
            <a href="/meals" class="btn btn-primary">View Meals</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Mood</h5>
            <p class="card-text">Your emotional wellbeing</p>
            <a href="/mood" class="btn btn-primary">View Mood</a>
          </div>
        </div>
      </div>
    </div>
  {{else}}
    <p>Create an Account and Start Your Healthy Life</p>
    <a class="btn btn-primary btn-lg" href="/auth/register" role="button">Get Started</a>
    <a class="btn btn-outline-secondary btn-lg" href="/auth/login" role="button">Login</a>
  {{/if}}
</div>