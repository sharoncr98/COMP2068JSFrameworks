<h1>{{title}}</h1>
<form method="POST" action="/meals/add">
  <div class="form-group">
    <label for="name">Meal Name:</label>
    <input type="text" id="name" name="name" class="form-control" required>
  </div>
  <div class="form-group">
    <label for="calories">Calories:</label>
    <input type="number" id="calories" name="calories" class="form-control" required>
  </div>
  <div class="form-group">
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" class="form-control" required>
  </div>
  <button type="submit" class="btn btn-success">Save Meal</button>
  <a href="/meals" class="btn btn-secondary">Cancel</a>
</form>