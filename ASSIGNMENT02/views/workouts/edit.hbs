<h1>{{title}}</h1>
<div class="card">
  <div class="card-body">
    <form method="POST" action="/workouts/edit/{{workout._id}}">
      <div class="mb-3">
        <label for="type" class="form-label">Workout Type:</label>
        <input type="text" id="type" name="type" class="form-control" value="{{workout.type}}" required>
      </div>
      <div class="mb-3">
        <label for="duration" class="form-label">Duration (minutes):</label>
        <input type="number" id="duration" name="duration" class="form-control" value="{{workout.duration}}" required>
      </div>
      <div class="mb-3">
        <label for="calories" class="form-label">Calories:</label>
        <input type="number" id="calories" name="calories" class="form-control" value="{{workout.calories}}">
      </div>
      <div class="mb-3">
        <label for="date" class="form-label">Date:</label>
        <input type="date" id="date" name="date" class="form-control" value="{{workout.date}}" required>
      </div>
      <div class="mb-3">
        <label for="notes" class="form-label">Notes:</label>
        <textarea id="notes" name="notes" class="form-control" rows="3">{{workout.notes}}</textarea>
      </div>
      <button type="submit" class="btn btn-success">Update Workout</button>
      <a href="/workouts" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>